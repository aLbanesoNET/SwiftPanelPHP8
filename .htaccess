# Swift Panel — Apache hardening.
# (nginx users: replicate these rules in the server block; see DEPLOY.md.)

Options -Indexes

# Never serve the DB credentials, even if PHP is mis-handled.
<FilesMatch "^(configuration\.php|DEPLOY\.md|.*\.sql|.*\.md)$">
    Require all denied
</FilesMatch>

# Back-end includes not meant to be requested directly.
RedirectMatch 403 ^/includes/

# FastDL: /fastdl/<token>/<path>  ->  fastdl.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^fastdl/([a-f0-9]{12,})/(.+)$ fastdl.php?t=$1&f=$2 [L,QSA]

    # Pass the Authorization header through to PHP (api.php bearer tokens).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
